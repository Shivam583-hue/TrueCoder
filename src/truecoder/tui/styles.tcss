/* TrueCoder semantic color system */
$background: #090b0e;
$surface: #0e1217;
$surface-raised: #141920;
$surface-hover: #1a2028;
$border: #252c36;
$border-strong: #37414d;
$text: #dbe2e9;
$text-secondary: #a7b1bc;
$text-muted: #7c8794;
$muted-border: #7c8794;
$orange: #f2a65a;
$orange-bright: #ffc27d;
$cyan: #67c6d4;
$green: #76c893;
$red: #ef6f78;

Screen {
    layout: vertical;
    background: $background;
    color: $text;
}

/* Header */
#topbar {
    width: 100%;
    height: 2;
    padding: 0 3;
    background: $surface;
    border-bottom: solid $border;
    content-align: left middle;
}

#brand-mark {
    width: 2;
    color: $orange;
    text-style: bold;
    content-align: left middle;
}

#brand-name {
    width: auto;
    color: $text;
    text-style: bold;
    content-align: left middle;
}

#mode-badge {
    width: auto;
    margin-left: 2;
    padding: 0 1;
    background: $surface-raised;
    color: $text-secondary;
    text-style: bold;
    content-align: center middle;
}

.bar-spacer,
.header-spacer,
.tool-spacer {
    width: 1fr;
}

#workspace-name {
    width: auto;
    max-width: 34;
    height: 1;
    margin-right: 2;
    color: $text-muted;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    content-align: right middle;
}

#model-name {
    width: auto;
    max-width: 28;
    height: 1;
    padding: 0 1;
    background: $surface-raised;
    color: $text-secondary;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    content-align: right middle;
}

/* Main timeline */
#main {
    width: 100%;
    height: 1fr;
    align-horizontal: center;
}

#transcript {
    width: 100%;
    height: 1fr;
    padding: 1 4;
    background: $background;
    align-horizontal: center;
    scrollbar-size: 1 1;
    scrollbar-color: $border-strong;
    scrollbar-color-hover: $text-muted;
    scrollbar-background: $background;
}

#empty-state {
    width: 100%;
    max-width: 72;
    height: 1fr;
    min-height: 8;
    align: center middle;
    content-align: center middle;
}

#ascii-logo {
    width: 55;
    height: 5;
    color: $text-secondary;
    opacity: 88%;
    text-style: bold;
    text-align: left;
    content-align: left middle;
}

#compact-logo {
    display: none;
    width: 100%;
    height: 1;
    color: $text;
    text-style: bold;
    text-align: center;
    content-align: center middle;
}

#splash-tagline {
    width: 100%;
    height: 1;
    margin-top: 1;
    color: $text-muted;
    text-align: center;
}

ChatMessage,
ToolCallCard {
    width: 100%;
    max-width: 104;
    height: auto;
}

ChatMessage {
    min-height: 3;
    margin-bottom: 1;
    padding: 0 1;
    background: transparent;
    border: none;
}

ChatMessage.user {
    width: 88%;
    max-width: 88;
    padding: 1 2;
    background: $surface-raised;
    border-left: solid $orange;
}

ChatMessage.assistant {
    padding: 1 2;
}

ChatMessage.error {
    background: #181115;
    border-left: solid $red;
}

ChatMessage.cancelled {
    border-left: solid $muted-border;
}

.message-header {
    width: 100%;
    height: 1;
    margin-bottom: 1;
}

.role-mark {
    width: 2;
    color: $orange;
    text-style: bold;
}

ChatMessage.assistant .role-mark,
ChatMessage.assistant .role-label {
    color: $cyan;
}

ChatMessage.error .role-mark,
ChatMessage.error .role-label {
    color: $red;
}

.role-label {
    width: auto;
    color: $orange-bright;
    text-style: bold;
}

.message-state {
    width: auto;
    color: $text-muted;
    text-align: right;
}

ChatMessage.streaming .message-state {
    color: $cyan;
}

ChatMessage.completed .message-state {
    color: $green;
}

ChatMessage.error .message-state,
ChatMessage.cancelled .message-state {
    color: $red;
}

.message-body {
    width: 100%;
    height: auto;
    padding: 0;
    color: $text;
    background: transparent;
}

.message-body MarkdownBlock {
    color: $text;
}

.message-body MarkdownParagraph {
    margin-bottom: 0;
}

.message-body MarkdownFence {
    margin: 1 0;
    padding: 0;
    background: #07090b;
    border: solid $border;
}

.message-body MarkdownFence > Label {
    padding: 1 2;
}

.message-body MarkdownBlock > .code_inline {
    background: $surface-hover;
    color: $orange-bright;
}

.message-body MarkdownH1,
.message-body MarkdownH2,
.message-body MarkdownH3 {
    color: $text;
    text-style: bold;
}

.message-footer {
    width: 100%;
    height: 1;
    margin-top: 1;
    color: $text-muted;
    text-align: right;
}

/* Persistent tool event */
ToolCallCard {
    min-height: 3;
    margin-bottom: 1;
    padding: 1 2;
    background: $surface;
    border: none;
    border-left: solid $cyan;
}

ToolCallCard.risky {
    background: #171214;
    border-left: solid $red;
}

.tool-heading {
    width: 100%;
    height: 1;
}

.tool-state-glyph {
    width: 2;
    color: $cyan;
    text-style: bold;
}

.tool-title {
    width: auto;
    max-width: 70%;
    color: $text;
    text-style: bold;
    text-overflow: ellipsis;
}

.tool-state-label {
    width: auto;
    margin-left: 1;
    color: $text-secondary;
    text-align: right;
}

.tool-summary {
    width: 100%;
    height: 1;
    margin-top: 1;
    padding-left: 2;
}

.tool-target {
    width: auto;
    max-width: 62%;
    color: $orange-bright;
    text-style: bold;
    text-overflow: ellipsis;
}

.tool-parameters {
    width: 1fr;
    color: $text-secondary;
    text-overflow: ellipsis;
}

.tool-approval-actions {
    display: none;
    width: 100%;
    height: 3;
    margin-top: 1;
    align-vertical: middle;
}

ToolCallCard.state-awaiting-approval .tool-approval-actions {
    display: block;
}

.tool-approval-actions Button {
    height: 3;
    margin-left: 1;
    padding: 0 1;
    border: none;
}

.approval-approve {
    min-width: 11;
    background: $orange;
    color: $background;
    text-style: bold;
}

.approval-always {
    min-width: 16;
    background: $surface-hover;
    color: $text;
}

.approval-reject {
    min-width: 10;
    background: transparent;
    color: $text-secondary;
    border: tall $border-strong;
}

.tool-approval-actions Button:focus {
    background: $orange-bright;
    color: $background;
    text-style: bold;
}

ToolCallCard.risky .tool-state-glyph,
ToolCallCard.risky .tool-state-label {
    color: $red;
}

ToolCallCard.risky .approval-reject {
    color: $red;
    border: tall $red;
}

ToolCallCard.state-completed,
ToolCallCard.state-rejected,
ToolCallCard.state-failed {
    min-height: 1;
    padding: 0 1;
}

ToolCallCard.state-completed {
    background: transparent;
    border-left: solid $green;
}

ToolCallCard.state-completed .tool-state-glyph,
ToolCallCard.state-completed .tool-state-label {
    color: $green;
}

ToolCallCard.state-rejected,
ToolCallCard.state-failed {
    border-left: solid $red;
}

ToolCallCard.state-rejected .tool-state-glyph,
ToolCallCard.state-rejected .tool-state-label,
ToolCallCard.state-failed .tool-state-glyph,
ToolCallCard.state-failed .tool-state-label {
    color: $red;
}

ToolCallCard.no-summary .tool-summary,
ToolCallCard.state-completed .tool-summary,
ToolCallCard.state-rejected .tool-summary,
ToolCallCard.state-failed .tool-summary {
    display: none;
}

.tool-details-toggle {
    display: none;
    width: 9;
    min-width: 9;
    height: 1;
    margin-left: 2;
    padding: 0 1;
    background: transparent;
    color: $text-secondary;
    border: none;
}

ToolCallCard.state-completed .tool-details-toggle,
ToolCallCard.state-rejected .tool-details-toggle,
ToolCallCard.state-failed .tool-details-toggle {
    display: block;
}

.tool-details-toggle:focus {
    background: $surface-hover;
    color: $orange-bright;
    text-style: bold;
}

.tool-details {
    display: none;
    width: 100%;
    height: auto;
    max-height: 12;
    margin-top: 1;
    padding: 1 2;
    background: #07090b;
    border-top: solid $border;
    scrollbar-size: 1 1;
    scrollbar-color: $border-strong;
    scrollbar-background: #07090b;
}

ToolCallCard.expanded .tool-details {
    display: block;
}

.tool-details-content {
    width: 100%;
    height: auto;
    color: $text-secondary;
}

/* Compact composer */
#composer-shell {
    width: 96%;
    max-width: 104;
    height: auto;
    max-height: 11;
    margin-bottom: 1;
    padding: 0 1;
    background: $surface-raised;
    border: solid $border-strong;
}

#composer-shell:focus-within {
    border: solid $orange;
}

#composer-row {
    width: 100%;
    height: auto;
    max-height: 8;
    align-vertical: bottom;
}

PromptInput {
    width: 1fr;
    height: 3;
    max-height: 8;
    padding: 0 1;
    background: transparent;
    color: $text;
    border: none;
    scrollbar-size: 1 1;
    scrollbar-color: $border-strong;
    scrollbar-background: $surface-raised;
}

PromptInput:focus {
    border: none;
}

PromptInput > .text-area--cursor-line {
    background: transparent;
}

PromptInput > .text-area--cursor {
    background: $orange;
    color: $background;
    text-style: bold;
}

PromptInput > .text-area--placeholder {
    color: $text-secondary;
}

#send-button {
    width: 10;
    min-width: 10;
    height: 3;
    margin-left: 1;
    padding: 0 1;
    background: $orange;
    color: $background;
    border: none;
    text-style: bold;
}

#send-button:hover,
#send-button:focus {
    background: $orange-bright;
    color: $background;
    text-style: bold;
}

#send-button:disabled {
    background: $border;
    color: $text-muted;
    opacity: 85%;
}

#composer-shell.busy #send-button:disabled {
    color: $cyan;
}

#composer-help,
#splash-context {
    width: 100%;
    height: 1;
    padding-left: 1;
    color: $text-muted;
}

#splash-context {
    display: none;
    padding: 0 1;
    text-align: center;
    text-overflow: ellipsis;
}

/* Footer */
#statusbar {
    width: 100%;
    height: 1;
    padding: 0 3;
    background: #07090b;
    color: $text-muted;
}

#shortcut-hint {
    width: auto;
    color: $text-muted;
}

#shortcut-hint {
    text-align: right;
}

/* Focused first-run composition */
Screen.empty-chat #topbar,
Screen.empty-chat #statusbar {
    display: none;
}

Screen.empty-chat #main {
    align: center middle;
}

Screen.empty-chat #transcript {
    width: 72;
    height: 8;
    padding: 0;
    scrollbar-size: 0 0;
}

Screen.empty-chat #empty-state {
    width: 100%;
    height: 8;
    min-height: 8;
}

Screen.empty-chat #composer-shell {
    width: 72;
    max-width: 90%;
    margin: 1 0 0 0;
    background: $surface-raised;
    border: solid $border-strong;
}

Screen.empty-chat #composer-shell:focus-within {
    border: solid $orange;
}

Screen.empty-chat #composer-help,
Screen.empty-chat #send-button {
    display: none;
}

Screen.empty-chat #splash-context {
    display: block;
}

/* Medium terminals */
Screen.-compact #workspace-name {
    display: none;
}

Screen.-compact #transcript {
    padding: 1 2;
}

/* Narrow terminals */
Screen.-narrow #topbar {
    padding: 0 1;
}

Screen.-narrow #mode-badge,
Screen.-narrow #workspace-name {
    display: none;
}

Screen.-narrow #model-name {
    max-width: 18;
}

Screen.-narrow #transcript {
    padding: 1;
}

Screen.-narrow ChatMessage.user {
    width: 100%;
}

Screen.-narrow #composer-shell {
    width: 96%;
}

Screen.-narrow #statusbar {
    padding: 0 1;
}

Screen.-narrow #shortcut-hint {
    width: 100%;
    text-align: center;
}

Screen.-narrow .tool-title {
    max-width: 52%;
}

Screen.-narrow .tool-state-label {
    display: none;
}

Screen.-narrow .tool-approval-actions {
    height: 9;
    layout: vertical;
    align-horizontal: right;
}

Screen.-narrow .tool-approval-actions .tool-spacer {
    display: none;
}

Screen.-narrow .tool-approval-actions Button {
    width: 16;
    height: 3;
    margin-left: 0;
}

Screen.-narrow #ascii-logo {
    display: none;
}

Screen.-narrow #compact-logo {
    display: block;
}

Screen.-narrow #splash-tagline {
    margin-top: 2;
}

Screen.-narrow.empty-chat #transcript {
    width: 92%;
    height: 5;
}

Screen.-narrow.empty-chat #empty-state {
    height: 5;
    min-height: 5;
}

Screen.-narrow.empty-chat #composer-shell {
    width: 92%;
}
