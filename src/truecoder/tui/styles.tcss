/* OpenCode-inspired terminal palette */
$tc-background: #0b0b0b;
$tc-surface: #141414;
$tc-surface-raised: #1e1e1e;
$tc-surface-hover: #272727;
$tc-border: #2d2d2d;
$tc-border-strong: #444444;
$tc-text: #dddddd;
$tc-text-secondary: #a2a2a2;
$tc-text-muted: #707070;
$tc-blue: #4da3ff;
$tc-orange: #f2a33a;
$tc-green: #67c587;
$tc-red: #ef6f78;

Screen {
    layout: vertical;
    background: $tc-background;
    color: $tc-text;
}

MemoryBrowserScreen,
WorkspaceChangesScreen,
CheckpointBrowserScreen,
RestoreCheckpointScreen,
SessionManagerScreen,
RenameSessionScreen,
DeleteSessionScreen,
AuditViewerScreen,
ModelPickerScreen,
ApiKeyScreen,
AuthorisationScreen,
ExecutionHealthScreen {
    align: center middle;
    background: #00000099;
}

#execution-health-dialog {
    width: 70;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    background: $tc-surface;
    border: solid $tc-border-strong;
}

.execution-health-title {
    height: 2;
    color: $tc-text;
    text-style: bold;
}

#execution-health-details {
    height: auto;
    max-height: 24;
    color: $tc-text-secondary;
    overflow-y: auto;
}

.execution-health-help {
    height: 1;
    margin-top: 1;
    color: $tc-text-muted;
}

#audit-viewer-dialog {
    width: 94%;
    height: 88%;
    padding: 1 2;
    background: $tc-surface;
    border: solid $tc-border-strong;
}

.audit-title {
    height: 2;
    color: $tc-text;
    text-style: bold;
}

#audit-search {
    height: 3;
}

#audit-filter-summary,
.audit-help {
    height: 1;
    color: $tc-text-muted;
}

#audit-content {
    height: 1fr;
    margin: 1 0;
}

#audit-list {
    width: 42%;
    height: 100%;
    background: transparent;
    border-right: solid $tc-border;
}

#audit-list ListItem {
    height: 3;
    padding: 0 1;
}

#audit-list ListItem.-highlight {
    background: $tc-surface-hover;
}

#audit-details {
    width: 1fr;
    height: 100%;
    padding: 0 2;
    overflow-y: auto;
    color: $tc-text-secondary;
}

#session-manager-dialog {
    width: 72;
    height: 24;
    padding: 1 2;
    background: $tc-surface;
    border: solid $tc-border-strong;
}

.session-small-dialog {
    width: 60;
    height: auto;
    padding: 1 2;
    background: $tc-surface;
    border: solid $tc-border-strong;
}

.session-dialog-title {
    height: 2;
    color: $tc-text;
    text-style: bold;
}

#session-list {
    height: 1fr;
    background: transparent;
    border: none;
}

#session-list ListItem {
    height: 3;
    padding: 0 1;
}

#session-list ListItem.-highlight {
    background: $tc-surface-hover;
    color: $tc-text;
}

.session-dialog-help {
    height: 1;
    color: $tc-text-muted;
}

#session-title-input {
    margin-bottom: 1;
}

#session-title-error {
    height: 1;
    color: $tc-red;
}

.session-delete-copy {
    height: auto;
    margin-bottom: 1;
    color: $tc-text-secondary;
}

.session-dialog-actions {
    height: 3;
    align-horizontal: right;
}

.session-dialog-actions Button {
    margin-left: 1;
}

.bar-spacer,
.tool-spacer {
    width: 1fr;
}

/* Transcript */
#main {
    width: 100%;
    height: 1fr;
    align-horizontal: center;
}

#transcript {
    width: 100%;
    height: 1fr;
    padding: 1 2;
    background: $tc-background;
    align-horizontal: center;
    scrollbar-size: 1 1;
    scrollbar-color: $tc-border-strong;
    scrollbar-color-hover: $tc-text-muted;
    scrollbar-background: $tc-background;
}

#empty-state {
    width: 100%;
    height: 7;
    align: center middle;
}

#ascii-logo {
    width: 27;
    height: 3;
    text-align: left;
    content-align: left middle;
}

#compact-logo {
    display: none;
    width: 100%;
    height: 1;
    color: $tc-text;
    text-style: bold;
    text-align: center;
    content-align: center middle;
}

ChatMessage,
ToolCallCard {
    width: 100%;
    height: auto;
}

ChatMessage {
    min-height: 3;
    margin-bottom: 0;
    padding: 1 3;
    background: transparent;
    border: none;
}

ChatMessage.user {
    min-height: 4;
    background: $tc-surface;
    border-left: solid $tc-blue;
}

ChatMessage.assistant {
    padding-top: 1;
    padding-bottom: 1;
}

ChatMessage.error {
    background: #171113;
    border-left: solid $tc-red;
}

ChatMessage.cancelled {
    border-left: solid #707070;
}

SystemNote {
    width: 100%;
    height: auto;
    margin-bottom: 1;
    padding: 1 2;
    background: $tc-surface;
    border-left: solid $tc-blue;
}

.note-heading {
    width: 100%;
    color: $tc-text;
    text-style: bold;
}

.note-body {
    width: 100%;
    color: $tc-text-secondary;
}

.note-detail {
    width: 100%;
    margin-top: 1;
    color: $tc-blue;
}

.message-body {
    width: 100%;
    height: auto;
    padding: 0;
    color: $tc-text;
    background: transparent;
}

.message-body MarkdownBlock {
    color: $tc-text;
}

.message-body MarkdownParagraph {
    margin-bottom: 1;
}

.message-body MarkdownBlock:last-child {
    margin-bottom: 0;
}

.message-body MarkdownFence {
    margin: 1 0;
    padding: 0;
    background: #080808;
    border: solid $tc-border;
}

.message-body MarkdownFence > Label {
    padding: 1 2;
}

.message-body MarkdownBlock > .code_inline {
    background: $tc-surface-hover;
    color: #e9b96e;
}

.message-body MarkdownH1,
.message-body MarkdownH2,
.message-body MarkdownH3 {
    color: $tc-text;
    text-style: bold;
}

.message-footer {
    width: 100%;
    height: 1;
    margin-top: 1;
    color: $tc-text-muted;
    text-align: left;
}

/* Persistent tool activity */
ToolCallCard {
    min-height: 3;
    margin-bottom: 1;
    padding: 1 3;
    background: transparent;
    border: none;
    border-left: solid $tc-blue;
}

ToolCallCard.risky {
    background: #171113;
    border-left: solid $tc-red;
}

.tool-heading {
    width: 100%;
    height: 1;
}

.tool-state-glyph {
    width: 2;
    color: $tc-blue;
    text-style: bold;
}

.tool-title {
    width: auto;
    max-width: 70%;
    color: $tc-text-secondary;
    text-overflow: ellipsis;
}

.tool-state-label {
    width: auto;
    margin-left: 1;
    color: $tc-text-muted;
    text-align: right;
}

.tool-summary {
    width: 100%;
    height: 1;
    margin-top: 1;
    padding-left: 2;
}

.tool-target {
    width: auto;
    max-width: 62%;
    color: #e9b96e;
    text-style: bold;
    text-overflow: ellipsis;
}

.tool-parameters {
    width: 1fr;
    color: $tc-text-secondary;
    text-overflow: ellipsis;
}

.tool-approval-actions {
    display: none;
    width: 100%;
    height: 3;
    margin-top: 1;
    align-horizontal: right;
    align-vertical: middle;
}

ToolCallCard.state-awaiting-approval .tool-approval-actions {
    display: block;
}

ToolCallCard.state-awaiting-approval {
    max-width: 104;
    padding: 1 2;
    background: $tc-surface;
}

.tool-approval-actions Button {
    height: 3;
    margin-left: 1;
    padding: 0 1;
    border: none;
}

.approval-once {
    min-width: 14;
    background: $tc-blue;
    color: $tc-background;
    text-style: bold;
}

.approval-session {
    min-width: 15;
    background: $tc-surface-hover;
    color: $tc-text;
}

.approval-workspace {
    min-width: 17;
    background: $tc-surface-hover;
    color: $tc-text;
}

.approval-reject {
    min-width: 10;
    background: transparent;
    color: $tc-text-secondary;
    border: tall $tc-border-strong;
}

.tool-approval-actions .scope-disabled {
    display: none;
}

.tool-approval-actions Button:focus {
    background: #8fc5ff;
    color: $tc-background;
    text-style: bold;
}

ToolCallCard.risky .tool-state-glyph,
ToolCallCard.risky .tool-state-label {
    color: $tc-red;
}

ToolCallCard.risky .approval-reject {
    color: $tc-red;
    border: tall $tc-red;
}

ToolCallCard.state-completed,
ToolCallCard.state-rejected,
ToolCallCard.state-failed {
    min-height: 1;
    padding-top: 0;
    padding-bottom: 0;
    background: transparent;
    border-left: none;
}

ToolCallCard.state-completed .tool-state-glyph {
    color: $tc-blue;
}

ToolCallCard.state-completed .tool-state-label {
    color: $tc-text-muted;
}

ToolCallCard.state-rejected .tool-state-glyph,
ToolCallCard.state-rejected .tool-state-label,
ToolCallCard.state-failed .tool-state-glyph,
ToolCallCard.state-failed .tool-state-label {
    color: $tc-red;
}

ToolCallCard.no-summary .tool-summary,
ToolCallCard.state-completed .tool-summary,
ToolCallCard.state-rejected .tool-summary,
ToolCallCard.state-failed .tool-summary {
    display: none;
}

.tool-details-toggle {
    display: none;
    width: 11;
    min-width: 11;
    height: 1;
    margin-left: 2;
    padding: 0 1;
    background: transparent;
    color: $tc-text-muted;
    border: none;
}

ToolCallCard.state-completed .tool-details-toggle,
ToolCallCard.state-rejected .tool-details-toggle,
ToolCallCard.state-failed .tool-details-toggle {
    display: block;
}

.tool-details-toggle:focus {
    background: $tc-surface-hover;
    color: #e9b96e;
    text-style: bold;
}

.tool-details {
    display: none;
    width: 100%;
    height: auto;
    max-height: 12;
    margin-top: 1;
    padding: 1 2;
    background: #080808;
    border-top: solid $tc-border;
    scrollbar-size: 1 1;
    scrollbar-color: $tc-border-strong;
    scrollbar-background: #080808;
}

ToolCallCard.expanded .tool-details {
    display: block;
}

.tool-details-content {
    width: 100%;
    height: auto;
    color: $tc-text-secondary;
}

/* Prompt composer */
#composer {
    width: 100%;
    height: auto;
    padding: 0 2;
}

#command-menu {
    width: 100%;
    height: auto;
    max-height: 14;
    padding: 1 2 0 2;
    margin-bottom: 1;
    background: $tc-surface-raised;
    border-left: solid $tc-blue;
}

.command-menu-row {
    width: 100%;
    height: 1;
    color: $tc-text-secondary;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.command-menu-row:last-of-type {
    margin-bottom: 1;
}

#composer-shell {
    width: 100%;
    height: auto;
    min-height: 5;
    max-height: 11;
    padding: 1 2 0 2;
    background: $tc-surface-raised;
    border: none;
    border-left: solid $tc-blue;
}

PromptInput {
    width: 100%;
    height: 2;
    max-height: 7;
    padding: 0;
    background: transparent;
    color: $tc-text;
    border: none;
    scrollbar-size: 1 1;
    scrollbar-color: $tc-border-strong;
    scrollbar-background: $tc-surface-raised;
}

PromptInput:focus {
    border: none;
}

PromptInput > .text-area--cursor-line {
    background: transparent;
}

PromptInput > .text-area--cursor {
    background: #dddddd;
    color: $tc-background;
    text-style: bold;
}

PromptInput > .text-area--placeholder {
    color: $tc-surface-raised;
}

#composer-metadata {
    width: 100%;
    height: 1;
    color: $tc-text-muted;
    text-overflow: ellipsis;
}

#launcher-shortcuts,
#launcher-tip {
    display: none;
}

/* Footer */
#statusbar {
    width: 100%;
    height: 1;
    padding: 0 2;
    background: #080808;
    color: $tc-text-muted;
}

#footer-workspace {
    width: auto;
    max-width: 65%;
    height: 1;
    color: $tc-text-muted;
    text-overflow: ellipsis;
}

#footer-status {
    width: auto;
    height: 1;
    color: $tc-text-muted;
    text-align: right;
}

/* Centered first-run composition */
Screen.empty-chat #main {
    align: center middle;
}

Screen.empty-chat #transcript {
    width: 76;
    height: 7;
    padding: 0;
    scrollbar-size: 0 0;
}

Screen.empty-chat #empty-state {
    width: 100%;
    height: 7;
}

Screen.empty-chat #composer {
    width: 76;
    padding: 0;
}

Screen.empty-chat PromptInput > .text-area--placeholder {
    color: $tc-text-muted;
}

Screen.empty-chat #launcher-shortcuts {
    display: block;
    width: 100%;
    height: 1;
    margin-top: 0;
    color: $tc-text-muted;
    text-align: left;
}

Screen.empty-chat #launcher-tip {
    display: block;
    width: 100%;
    height: 1;
    margin-top: 3;
    color: $tc-text-muted;
    text-align: center;
}

/* Medium terminals */
Screen.-compact #transcript {
    padding: 1;
}

Screen.-compact #composer {
    padding: 0 1;
}

Screen.-compact.empty-chat #transcript,
Screen.-compact.empty-chat #composer {
    width: 72;
    padding: 0;
}

/* Narrow terminals */
Screen.-narrow #transcript {
    padding: 0;
}

Screen.-narrow ChatMessage {
    padding-left: 1;
    padding-right: 1;
}

Screen.-narrow #composer {
    padding: 0;
}

Screen.-narrow #statusbar {
    padding: 0 1;
}

Screen.-narrow #footer-workspace {
    max-width: 55%;
}

Screen.-narrow .tool-title {
    max-width: 52%;
}

Screen.-narrow .tool-state-label {
    display: none;
}

Screen.-narrow .tool-approval-actions {
    height: 6;
    layout: grid;
    grid-size: 2 2;
    grid-columns: 1fr 1fr;
    grid-rows: 3 3;
    grid-gutter: 0 1;
}

Screen.-narrow ToolCallCard.approval-once-only .tool-approval-actions {
    height: 3;
    grid-size: 2 1;
    grid-rows: 3;
}

Screen.-narrow .tool-approval-actions Button {
    width: 1fr;
    height: 3;
    margin-left: 0;
}

Screen.-narrow #ascii-logo {
    display: none;
}

Screen.-narrow #compact-logo {
    display: block;
}

Screen.-narrow.empty-chat #transcript {
    width: 92%;
    height: 4;
}

Screen.-narrow.empty-chat #empty-state {
    height: 4;
}

Screen.-narrow.empty-chat #composer {
    width: 92%;
}

Screen.-narrow.empty-chat #launcher-tip {
    height: auto;
    margin-top: 2;
}

/* Reviewable file mutation */
.tool-diff {
    display: none;
    width: 100%;
    height: auto;
    max-height: 22;
    margin-top: 1;
    padding: 0 1;
    background: #0f0f0f;
    border-left: solid $tc-border-strong;
    scrollbar-size-vertical: 1;
}

ToolCallCard.state-awaiting-approval.has-diff .tool-diff {
    display: block;
}

.tool-diff-content {
    width: auto;
    height: auto;
}

Screen.-narrow .tool-diff {
    max-height: 14;
    padding: 0;
}

#memory-dialog {
    width: 78;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    background: $tc-surface;
    border: solid $tc-border-strong;
}

#memory-summary {
    height: 2;
    color: $tc-text-muted;
}

#memory-list {
    height: auto;
    max-height: 20;
    background: transparent;
}

#memory-list ListItem {
    padding: 0 1;
    background: transparent;
    color: $tc-text-secondary;
}

#memory-list ListItem.-highlight {
    background: $tc-surface-hover;
    color: $tc-text;
}

#memory-empty {
    margin-top: 1;
    color: $tc-text-muted;
}

#changes-dialog {
    width: 92%;
    height: 84%;
    padding: 1 2;
    background: $tc-surface;
    border: solid $tc-border-strong;
}

#changes-summary {
    height: 2;
    color: $tc-text;
    text-style: bold;
}

#changes-body {
    height: 1fr;
    margin-bottom: 1;
    overflow-x: auto;
    scrollbar-size: 1 1;
}

#changes-content {
    width: auto;
    height: auto;
}

#changes-empty,
#changes-unavailable {
    margin-top: 1;
    color: $tc-text-muted;
}

#checkpoint-dialog {
    width: 74;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    background: $tc-surface;
    border: solid $tc-border-strong;
}

#checkpoint-list {
    height: auto;
    max-height: 18;
    margin-top: 1;
    background: transparent;
}

#checkpoint-list ListItem {
    padding: 0 1;
    background: transparent;
    color: $tc-text-secondary;
}

#checkpoint-list ListItem.-highlight {
    background: $tc-surface-hover;
    color: $tc-text;
}

#checkpoint-empty,
#checkpoint-unavailable {
    margin-top: 1;
    color: $tc-text-muted;
}

#checkpoint-removals {
    margin-top: 1;
    color: $tc-red;
}

#checkpoint-safety {
    margin-top: 1;
    color: $tc-text-muted;
}

/* Task plan */
PlanCard {
    width: 100%;
    height: auto;
    margin-bottom: 1;
    padding: 1 3;
    background: transparent;
    border: none;
    border-left: solid $tc-blue;
}

PlanCard.complete {
    border-left: solid $tc-green;
}

.plan-heading {
    width: 100%;
    height: 1;
}

.plan-glyph {
    width: 2;
    min-width: 2;
    color: $tc-blue;
    text-style: bold;
}

PlanCard.complete .plan-glyph {
    color: $tc-green;
}

.plan-title {
    width: auto;
    color: $tc-text;
    text-style: bold;
}

.plan-progress {
    width: auto;
    margin-left: 1;
    color: $tc-text-muted;
    text-align: right;
}

.plan-steps {
    width: 100%;
    height: auto;
    margin-top: 1;
    padding-left: 2;
}

Screen.-narrow PlanCard {
    padding: 1 1;
}

/* Shell execution card */
ExecutionCard {
    width: 100%;
    min-height: 3;
    margin-bottom: 1;
    padding: 1 3;
    background: transparent;
    border: none;
}

.execution-heading {
    width: 100%;
    height: 1;
}

.execution-glyph {
    width: 2;
    min-width: 2;
    color: $tc-text-muted;
}

ExecutionCard.state-running .execution-glyph,
ExecutionCard.state-starting .execution-glyph {
    color: $tc-blue;
}

ExecutionCard.state-completed .execution-glyph {
    color: $tc-green;
}

ExecutionCard.state-failed .execution-glyph,
ExecutionCard.state-cancelled .execution-glyph,
ExecutionCard.state-rejected .execution-glyph {
    color: $tc-red;
}

ExecutionCard.state-awaiting-approval .execution-glyph,
ExecutionCard.state-cancelling .execution-glyph,
ExecutionCard.state-terminating .execution-glyph {
    color: $tc-orange;
}

.execution-title {
    width: auto;
    max-width: 60%;
    color: $tc-text;
    text-style: bold;
}

.execution-state-label {
    width: auto;
    color: $tc-text-muted;
}

.execution-cancel {
    display: none;
    width: 6;
    min-width: 6;
    height: 1;
    margin-left: 2;
    padding: 0 1;
    background: transparent;
    color: $tc-red;
    border: none;
}

ExecutionCard.state-running .execution-cancel,
ExecutionCard.state-starting .execution-cancel,
ExecutionCard.state-terminating .execution-cancel {
    display: block;
}

.execution-cancel:focus {
    background: $tc-surface-hover;
    text-style: bold;
}

.execution-cancel:disabled {
    display: none;
}

.execution-details-toggle {
    width: 11;
    min-width: 11;
    height: 1;
    margin-left: 2;
    padding: 0 1;
    background: transparent;
    color: $tc-text-muted;
    border: none;
}

.execution-details-toggle:focus {
    background: $tc-surface-hover;
    color: $tc-orange;
    text-style: bold;
}

.execution-summary {
    width: 100%;
    height: auto;
    margin-top: 1;
    padding-left: 2;
    color: $tc-text-secondary;
}

.execution-output {
    display: none;
    width: 100%;
    height: auto;
    max-height: 14;
    margin-top: 1;
    padding: 1 2;
    background: #080808;
    border-left: solid $tc-border;
    scrollbar-size: 1 1;
    scrollbar-color: $tc-border-strong;
    scrollbar-background: #080808;
}

ExecutionCard.state-running .execution-output,
ExecutionCard.state-terminating .execution-output,
ExecutionCard.state-cancelling .execution-output,
ExecutionCard.state-completed .execution-output,
ExecutionCard.state-failed .execution-output,
ExecutionCard.state-cancelled .execution-output {
    display: block;
}

.execution-output-content {
    width: 100%;
    height: auto;
    color: $tc-text-secondary;
}

.execution-details {
    display: none;
    width: 100%;
    height: auto;
    max-height: 16;
    margin-top: 1;
    padding: 1 2;
    background: #080808;
    border-top: solid $tc-border;
    scrollbar-size: 1 1;
    scrollbar-color: $tc-border-strong;
    scrollbar-background: #080808;
}

ExecutionCard.expanded .execution-details {
    display: block;
}

.execution-details-content {
    width: 100%;
    height: auto;
    color: $tc-text-secondary;
}

/* Model picker */
#model-picker-dialog {
    width: 78;
    max-width: 92%;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    background: $tc-surface;
    border: round $tc-border;
}

.model-dialog-title {
    color: $tc-text;
    text-style: bold;
    margin-bottom: 1;
}

#model-filter {
    margin-bottom: 1;
    background: $tc-surface-hover;
    border: none;
    height: 3;
}

#model-list {
    height: auto;
    max-height: 24;
    background: transparent;
}

.model-item {
    padding: 0 1;
    background: transparent;
}

.model-item.active .model-item-line {
    color: $tc-blue;
    text-style: bold;
}

.invite-line {
    color: $tc-text-muted;
    text-style: italic;
}

.model-item-line {
    width: 100%;
    color: $tc-text-secondary;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.model-dialog-empty {
    color: $tc-text-muted;
    margin-bottom: 1;
}

.model-dialog-help {
    color: $tc-text-muted;
    margin-top: 1;
}

/* Credential dialogs */
#api-key-dialog,
#authorisation-dialog {
    width: 74;
    max-width: 92%;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    background: $tc-surface;
    border: round $tc-border;
}

.credential-title {
    color: $tc-text;
    text-style: bold;
    margin-bottom: 1;
}

.credential-body {
    color: $tc-text-secondary;
    margin-bottom: 1;
}

#api-key-input {
    margin-bottom: 1;
    background: $tc-surface-hover;
    border: none;
    height: 3;
}

.credential-note {
    color: $tc-text-muted;
}

#authorisation-url {
    width: 100%;
    height: auto;
    max-height: 4;
    margin: 1 0;
    padding: 0 1;
    color: $tc-blue;
    background: $tc-surface-raised;
    border-left: solid $tc-blue;
    overflow-y: auto;
    scrollbar-size: 1 1;
}

#authorisation-actions {
    width: 100%;
    height: auto;
}

#authorisation-actions Button {
    width: 14;
    height: 3;
    margin-right: 2;
}

.credential-help {
    color: $tc-text-muted;
    margin-top: 1;
}
